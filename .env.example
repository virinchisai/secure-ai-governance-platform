# Local defaults. Copy to .env and replace the JWT secret before shared use.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://governance:governance@postgres:5432/governance
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=secure-ai-governance
JWT_TTL_MINUTES=60
GRAPH_PROVIDER=local
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
APPROVAL_TTL_MINUTES=30
CACHE_TTL_SECONDS=300

# Microsoft integration-ready settings; leave unset for LocalGraphSimulator.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

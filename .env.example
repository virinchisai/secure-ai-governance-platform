# Host-local defaults. Compose overrides persistence and retrieval with PostgreSQL/pgvector.
# Copy to .env and replace the JWT secret before shared use.
ENVIRONMENT=local
DATABASE_URL=sqlite:///./governance.db
PERSISTENCE_MODE=memory
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=secure-ai-governance
JWT_TTL_MINUTES=60
GRAPH_PROVIDER=local
IDENTITY_MODE=local
OIDC_ISSUER=http://localhost:8080/realms/governance
OIDC_AUDIENCE=governance-api
# Optional container-internal JWKS URL when it differs from the token issuer URL.
# OIDC_JWKS_URL=http://keycloak:8080/realms/governance/protocol/openid-connect/certs
POLICY_PROVIDER=local
OPA_URL=http://localhost:8181/v1/data/governance/dlp/decision
CLASSIFIER_PROVIDER=local
PRESIDIO_URL=http://localhost:5001
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
RAG_MODE=local
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
APPROVAL_TTL_MINUTES=30
CACHE_TTL_SECONDS=300
# Set to http://localhost:9200 only when the local OpenSearch service is running.
# OPENSEARCH_URL=

# Microsoft integration-ready settings; leave unset for LocalGraphSimulator.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
